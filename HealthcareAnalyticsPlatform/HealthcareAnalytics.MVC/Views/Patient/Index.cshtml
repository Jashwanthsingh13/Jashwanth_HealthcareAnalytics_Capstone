@model IEnumerable<HealthcareAnalytics.MVC.Models.PatientViewModel>

@{
ViewData["Title"] = "Patient Management";
}

@if (TempData["SuccessMessage"] != null)
{ <div class="alert alert-success alert-dismissible fade show"
      role="alert">


    @TempData["SuccessMessage"]

    <button type="button"
            class="btn-close"
            data-bs-dismiss="alert">
    </button>

</div>


}

<div class="page-header d-flex justify-content-between align-items-center mb-4">

<h2>Patient Management</h2>

<a asp-action="Create"
   class="btn btn-primary">

    <i class="bi bi-plus-circle"></i>
    Add Patient

</a>


</div>

<div class="search-card mb-3">


<input type="text"
       id="patientSearch"
       class="form-control"
       placeholder="Search patient..." />


</div>

<div class="table-card">


<table class="table table-hover"
       id="patientTable">

    <thead class="table-light">

        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Gender</th>
            <th>Actions</th>
        </tr>

    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>

                    <td>@item.PatientId</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Gender</td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@item.PatientId"
                           class="btn btn-info btn-sm">
                            View
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.PatientId"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.PatientId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>

                <td colspan="6" class="text-center">
                    No patients found.
                </td>

            </tr>
        }

    </tbody>

</table>


</div>

@section Scripts
{ <script>

    document
        .getElementById("patientSearch")
        .addEventListener("keyup", function () {

            let value =
                this.value.toLowerCase();

            let rows =
                document.querySelectorAll(
                    "#patientTable tbody tr"
                );

            rows.forEach(function (row) {

                let text =
                    row.innerText.toLowerCase();

                row.style.display =
                    text.includes(value)
                        ? ""
                        : "none";

            });

        });

</script>
}
