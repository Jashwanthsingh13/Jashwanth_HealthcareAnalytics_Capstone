@model AppointmentViewModel

<div class="form-card">

<h2 class="text-danger">

Delete Appointment

</h2>

<hr/>

<p>

Are you sure you want
to delete this appointment?

</p>

<form asp-action="Delete">

<input type="hidden"
       asp-for="AppointmentId"/>

<button class="btn btn-danger">

Delete

</button>

<a asp-action="Index"
   class="btn btn-secondary">

Cancel

</a>

</form>

</div>