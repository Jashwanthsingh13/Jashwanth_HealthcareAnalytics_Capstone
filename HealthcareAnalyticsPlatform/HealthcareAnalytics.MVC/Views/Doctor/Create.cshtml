@model HealthcareAnalytics.MVC.Models.DoctorViewModel

<h2>Add Doctor</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="DoctorName" class="form-label"></label>
        <input asp-for="DoctorName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Specialization" class="form-label"></label>
        <input asp-for="Specialization" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Save Doctor
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>