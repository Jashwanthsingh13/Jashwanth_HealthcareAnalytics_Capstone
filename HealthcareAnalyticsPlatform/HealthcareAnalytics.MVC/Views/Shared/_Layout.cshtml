<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Healthcare Analytics</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>

<body>

    <!-- Sidebar -->

    <div class="sidebar">

        <div class="logo-section">

            <h2>
                <i class="bi bi-heart-pulse-fill"></i>
                Healthcare
            </h2>

            <span>Analytics</span>

        </div>

        <ul>

            <li>

                <a asp-controller="Dashboard"
                   asp-action="Index">

                    <i class="bi bi-speedometer2"></i>

                    Dashboard

                </a>

            </li>

            <li>

                <a asp-controller="Patient"
                   asp-action="Index">

                    <i class="bi bi-people-fill"></i>

                    Patients

                </a>

            </li>

            <li>

                <a asp-controller="Appointment"
                   asp-action="Index">

                    <i class="bi bi-calendar-check"></i>

                    Appointments

                </a>

            </li>

             <li>
                <a asp-controller="Doctor"
                   asp-action="Index">
                    <i class="bi bi-person-badge-fill"></i>
                    Doctors
                </a>
            </li>

            <li>

                <a asp-controller="Reports"
                   asp-action="Index">

                    <i class="bi bi-bar-chart-fill"></i>

                    Reports

                </a>

            </li>

            <li>

                <a asp-controller="Settings"
                   asp-action="Index">

                    <i class="bi bi-gear-fill"></i>

                    Settings

                </a>

            </li>

              <li>

            <a asp-controller="User"
               asp-action="Index">

            <i class="bi bi-people"></i>

            Users

            </a>

            </li>

        </ul>
        <hr/>

<a asp-controller="Account"
   asp-action="Logout">

<i class="bi bi-box-arrow-right"></i>

Logout

</a>

    </div>

    <!-- Main Content -->

    <div class="main-content">

    @RenderBody()

    <footer class="footer-section">

        <hr/>

        <p>
            © 2026 Healthcare Analytics
        </p>

        <p>
            Empowering efficient healthcare management
        </p>

    </footer>

</div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>