@model HealthcareAnalytics.MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-copy">
            <span class="eyebrow">Healthcare Analytics Platform</span>
            <h1>Sign in to your portal</h1>
            <p>Use the role selector to enter the Admin, Doctor, or Patient experience.</p>

            @* <div class="auth-hint-grid">
                <div>
                    <span>Admin</span>
                    <strong>admin / Admin@123</strong>
                </div>
                <div>
                    <span>Doctor</span>
                    <strong>doctor / Doctor@123</strong>
                </div>
                <div>
                    <span>Patient</span>
                    <strong>patient / Patient@123</strong>
                </div>
            </div> *@
        </div>

        <form asp-action="Login" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control form-control-lg" placeholder="Username or email" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control form-control-lg" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select form-select-lg">
                    <option value="">Select a role</option>
                    <option value="Admin">Admin</option>
                    <option value="Doctor">Doctor</option>
                    <option value="Patient">Patient</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}