@model HealthcareAnalytics.MVC.Models.AppointmentViewModel

<h2>Create Appointment</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label>Patient Id</label>

        <input asp-for="PatientId"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Date</label>

        <input asp-for="AppointmentDate"
               type="datetime-local"
               class="form-control" />
    </div>

    <button class="btn btn-success">
        Save
    </button>

</form>